# Everything shared between the agent sandboxes (full toolset, hardened
# sshd, docker client, OpenCode) lives in mwaeckerlin/sandbox-base — this
# image only adds the hermes skills and its entrypoint.
FROM mwaeckerlin/mcp-github AS mcp_github_skills

FROM mwaeckerlin/sandbox-base AS build
ENV CONTAINERNAME="hermes"
# opencode-delegate: the agent hands a development task to the central OpenCode
# server and gets the answer back; OpenCode itself comes with sandbox-base
COPY --chmod=0755 files/opencode-delegate /usr/local/bin/opencode-delegate
ADD files/SKILL.md /opt/hermes/skills/ssh-sandbox/SKILL.md
ADD files/opencode-delegation/SKILL.md /opt/hermes/skills/opencode-delegation/SKILL.md
COPY --from=mcp_github_skills /app/skills/mcp-github/SKILL.md /opt/hermes/skills/mcp-github/SKILL.md
ADD files/sandbox-entrypoint.sh /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]

FROM build
