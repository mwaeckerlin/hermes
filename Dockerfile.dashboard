# Stage 1: build the pairing plugin frontend (Node is only needed here, not at runtime)
FROM node:22-alpine AS plugin-builder
WORKDIR /build
COPY files/pairing-plugin/package.json files/pairing-plugin/package-lock.json ./
RUN npm ci
COPY files/pairing-plugin/src ./src
RUN npm run build

# Stage 2: final dashboard image — one Python process at runtime
FROM nousresearch/hermes-agent:latest
USER root
COPY --chown=hermes:hermes files/pairing-plugin/manifest.json /opt/hermes/plugins/pairing/dashboard/manifest.json
COPY --chown=hermes:hermes files/pairing-plugin/api.py /opt/hermes/plugins/pairing/dashboard/api.py
COPY --chown=hermes:hermes --from=plugin-builder /build/dist/index.js /opt/hermes/plugins/pairing/dashboard/dist/index.js
USER hermes
