# Stage 1: build the pairing plugin frontend (Node is only needed here, not at runtime)
FROM node:22-alpine AS pairing-plugin-builder
WORKDIR /build
COPY files/pairing-plugin/package.json files/pairing-plugin/package-lock.json ./
RUN npm ci
COPY files/pairing-plugin/src ./src
RUN npm run build

# Stage 2: build the TODO plugin frontend
FROM node:22-alpine AS todo-plugin-builder
WORKDIR /build
COPY files/todo-plugin/package.json files/todo-plugin/package-lock.json ./
RUN npm ci
COPY files/todo-plugin/src ./src
RUN npm run build

# Stage 3: final dashboard image — one Python process at runtime
FROM nousresearch/hermes-agent:latest
USER root
COPY --chown=hermes:hermes files/pairing-plugin/manifest.json /opt/hermes/plugins/pairing/dashboard/manifest.json
COPY --chown=hermes:hermes files/pairing-plugin/api.py /opt/hermes/plugins/pairing/dashboard/api.py
COPY --chown=hermes:hermes --from=pairing-plugin-builder /build/dist/index.js /opt/hermes/plugins/pairing/dashboard/dist/index.js
COPY --chown=hermes:hermes files/todo-plugin/manifest.json /opt/hermes/plugins/todo/dashboard/manifest.json
COPY --chown=hermes:hermes files/todo-plugin/api.py /opt/hermes/plugins/todo/dashboard/api.py
COPY --chown=hermes:hermes files/todo-plugin/storage.py /opt/hermes/plugins/todo/dashboard/storage.py
COPY --chown=hermes:hermes --from=todo-plugin-builder /build/dist/index.js /opt/hermes/plugins/todo/dashboard/dist/index.js
ENV HERMES_HOME=/opt/data
USER hermes
