# Stage 1: build the pairing plugin frontend (Node is only needed here, not at runtime)
FROM mwaeckerlin/nodejs-build AS pairing-plugin-builder
COPY --chown=${BUILD_USER} files/pairing-plugin/package.json files/pairing-plugin/package-lock.json ./
RUN npm ci
COPY --chown=${BUILD_USER} files/pairing-plugin/src ./src
RUN npm run build

# Stage 2: build the TODO plugin frontend
FROM mwaeckerlin/nodejs-build AS todo-plugin-builder
COPY --chown=${BUILD_USER} files/todo-plugin/package.json files/todo-plugin/package-lock.json ./
RUN npm ci
COPY --chown=${BUILD_USER} files/todo-plugin/src ./src
RUN npm run build

# Stage 3: final dashboard image. It keeps the user of the upstream image: its
# s6 init starts as root and drops to the hermes user itself, and it dies on
# «mkdir /run/s6: Permission denied» when the image starts as hermes.
FROM nousresearch/hermes-agent:latest
COPY --chown=hermes:hermes files/pairing-plugin/manifest.json /opt/hermes/plugins/pairing/dashboard/manifest.json
COPY --chown=hermes:hermes files/pairing-plugin/api.py /opt/hermes/plugins/pairing/dashboard/api.py
COPY --chown=hermes:hermes --from=pairing-plugin-builder /app/dist/index.js /opt/hermes/plugins/pairing/dashboard/dist/index.js
COPY --chown=hermes:hermes files/todo-plugin/manifest.json /opt/hermes/plugins/todo/dashboard/manifest.json
COPY --chown=hermes:hermes files/todo-plugin/api.py /opt/hermes/plugins/todo/dashboard/api.py
COPY --chown=hermes:hermes files/todo-plugin/storage.py /opt/hermes/plugins/todo/dashboard/storage.py
COPY --chown=hermes:hermes --from=todo-plugin-builder /app/dist/index.js /opt/hermes/plugins/todo/dashboard/dist/index.js
# Docker secrets become the dashboard's variables before it starts, so the
# login can come from secrets without a wrapper in front of s6
COPY --chmod=0755 files/dashboard-secrets.sh /etc/cont-init.d/03-docker-secrets
# HERMES_BASE_PATH: the dashboard serves below a path of its own (README,
# Base Path Mechanism); the build stops when upstream changed what it uses
COPY files/base-path/hermes_base_path.py files/base-path/install-hook.py /opt/hermes-base-path/
RUN /opt/hermes/.venv/bin/python3 /opt/hermes-base-path/install-hook.py /opt/hermes /opt/hermes-base-path "${HERMES_WEB_DIST}"
ENV HERMES_HOME=/opt/data
